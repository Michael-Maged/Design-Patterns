    -in: Scanner
    -out: PrintStream
    --
    +BeneficiaryView(in: Scanner, out: PrintStream)
    +showMenu(currentRule: String, zeroLabel: String): int
    +ask(prompt: String): String
    +askNumber(prompt: String): int
    +showList(lines: List<String>, emptyText: String): void
