package "Service: needs, distribution, reports" as service #F3EEF8 {
  class BeneficiaryService <<Model>> <<Context>> {
    -beneficiaries: Map<String, Beneficiary>
    -needs: Map<String, Need>
    -distributions: List<Distribution>
    -bus: EventBus
    -strategy: AllocationStrategy
    -urgentResponders: Audience
    --
    .. beneficiaries and needs ..
    +registerBeneficiary(beneficiary: Beneficiary): Beneficiary
    +findBeneficiary(beneficiaryId: String): Beneficiary
    +removeBeneficiary(beneficiaryId: String): boolean
    +updateBeneficiary(beneficiaryId: String, name: String, email: String, phone: String, preferredContact: ContactPreference, area: String, householdSize: int): Beneficiary
    +addNeed(beneficiaryId: String, category: String, quantity: int, urgency: Urgency, requestedOn: LocalDate): Need
    +updateNeed(needId: String, quantity: int, urgency: Urgency): Need
    +removeNeed(needId: String): boolean
    +openNeeds(category: String): List<Need>
    +setUrgentResponders(responders: Audience): void
    .. strategy ..
    +setStrategy(strategy: AllocationStrategy): void
    +setStrategy(mode: AllocationMode): void
    .. distribution ..
    +preview(category: String, available: int): Map<Need, Integer>
    +distribute(program: String, category: String, available: int, date: LocalDate): List<Distribution>
    +giveDirectly(needId: String, units: int, program: String, date: LocalDate): Distribution
    .. reports ..
    +programImpactReport(program: String, date: LocalDate): String
    +progressReport(beneficiaryId: String, date: LocalDate): String
  }
}

' ---- Model ----
Beneficiary -up-|> Person
Beneficiary "1" *-- "*" Need : needs
Need "*" --> "1" Beneficiary : beneficiary
Need --> "1" Urgency
Beneficiary "1" o-- "*" Distribution : distributions
Distribution "*" --> "1" Need : need

' ---- Strategy ----
UrgencyFirstAllocation .up.|> AllocationStrategy
FirstComeFirstServedAllocation .up.|> AllocationStrategy
EqualShareAllocation .up.|> AllocationStrategy
AllocationMode ..> AllocationStrategy : <<creates>>
AllocationStrategy ..> Need : allocates units to
note bottom of AllocationStrategy
  BeneficiaryService (the Context) holds one strategy
  and can swap it at runtime (setStrategy), so the same
  stock may go to different people:
  urgency first | first come, first served | equal share.
  UrgencyFirst and FirstCome only change the order and
  reuse fillInOrder(); EqualShare hands out one unit
  at a time in turn.
end note

' ---- Template Method ----
ProgramImpactReport -up-|> ImpactReport
BeneficiaryProgressReport -up-|> ImpactReport
ProgramImpactReport --> "*" Distribution : allDistributions
BeneficiaryProgressReport --> "1" Beneficiary : beneficiary
note bottom of ImpactReport
  generate() is final:
  collectData -> hasData? -> computeMetrics
  -> title / scope -> formatRows -> metrics
  -> summary -> footer (hook)
end note

' ---- MVC ----
BeneficiaryController --> "1" BeneficiaryView : view
BeneficiaryController --> "1" BeneficiaryService : model
BeneficiaryController ..> AllocationMode
note right of BeneficiaryController
  MVC: BeneficiaryView (View), BeneficiaryController
  (Controller), BeneficiaryService (Model). Opened from
  the main menu (embedded: 0 = Back); after each action
  the view shows the deliveries passed in, so this
  module never imports Communication.
end note

' ---- Service ----
BeneficiaryService "1" o-- "1" AllocationStrategy : strategy
BeneficiaryService "1" o-- "*" Beneficiary
BeneficiaryService "1" o-- "*" Need
BeneficiaryService "1" o-- "*" Distribution
BeneficiaryService ..> AllocationMode
BeneficiaryService --> "0..1" Audience : urgentResponders
BeneficiaryService ..> ImpactReport : <<issues>>
BeneficiaryService ..> EventBus : publishes URGENT_NEED,\nRESOURCE_DISTRIBUTED
BeneficiaryService ..> SystemEvent : <<creates>>
SystemEvent --> SystemEventType
note right of BeneficiaryService
  A HIGH-urgency need is published as URGENT_NEED
  with the Audience (volunteers, set by DataStore)
  as its source, so this module never imports the
  Volunteers package. Every distribution publishes
  RESOURCE_DISTRIBUTED to the beneficiary.
end note
@enduml
