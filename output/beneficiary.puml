' Beneficiaries module (Student 4): class diagram organised by design pattern.
' Written by hand from the source in org.nonprofit.beneficiary (the UML generator was not available).
' Only the important members are shown; plain getters, private helpers and id counters are left out.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60
hide circle
hide empty members
top to bottom direction

package "org.nonprofit.core (shared)" as core #F5F5F5 {
  abstract class Person {
    -id: String
    -name: String
    -email: String
    -phone: String
    -preferredContact: ContactPreference
  }
  interface Audience {
    +getAudience(): List<? extends Person>
  }
  class EventBus <<Singleton>> {
    +{static} getInstance(): EventBus
    +publish(event: SystemEvent): void
  }
  class SystemEvent {
    -type: SystemEventType
    -message: String
    -recipient: Person
    -source: Object
  }
  enum SystemEventType {
    RESOURCE_DISTRIBUTED
    URGENT_NEED
    ...
  }
}

package "Model: beneficiaries, needs, distributions" as model #EEF7EE {
  class Beneficiary {
    -area: String
    -householdSize: int
    -needs: List<Need>
    -distributions: List<Distribution>
    --
    +Beneficiary(name: String, email: String, phone: String, preferredContact: ContactPreference, area: String, householdSize: int)
    +Beneficiary(name: String, phone: String, area: String, householdSize: int)
    +openNeeds(): List<Need>
    +unitsReceived(): int
    +summary(): String
    .. bookkeeping (package-private) ..
    ~updateDetails(name: String, email: String, phone: String, preferredContact: ContactPreference, area: String, householdSize: int): void
    ~addNeed(need: Need): void
    ~removeNeed(need: Need): void
    ~addDistribution(distribution: Distribution): void
  }

  class Need {
    -id: String
    -beneficiary: Beneficiary
    -category: String
    -quantity: int
    -urgency: Urgency
    -requestedOn: LocalDate
    -received: int
    --
    ~Need(beneficiary: Beneficiary, category: String, quantity: int, urgency: Urgency, requestedOn: LocalDate)
    ~update(quantity: int, urgency: Urgency): void
    ~receive(units: int): void
    +remaining(): int
    +isMet(): boolean
    +percentMet(): double
    +summary(): String
  }

  enum Urgency {
    LOW
    MEDIUM
    HIGH
    --
    +{static} fromString(input: String): Urgency
  }

  class Distribution {
    -id: String
    -need: Need
    -quantity: int
    -program: String
    -date: LocalDate
    --
    ~Distribution(need: Need, quantity: int, program: String, date: LocalDate)
    +getBeneficiary(): Beneficiary
    +summary(): String
  }
}

package "STRATEGY: sharing limited stock between needs" as strategy #EAF2FB {
  interface AllocationStrategy <<Strategy>> {
    +allocate(needs: List<Need>, available: int): Map<Need, Integer>
    +name(): String
    +{static} fillInOrder(ordered: List<Need>, available: int): Map<Need, Integer>
  }

  class UrgencyFirstAllocation <<ConcreteStrategy>> {
    +allocate(needs: List<Need>, available: int): Map<Need, Integer>
    +name(): String
  }

  class FirstComeFirstServedAllocation <<ConcreteStrategy>> {
    +allocate(needs: List<Need>, available: int): Map<Need, Integer>
    +name(): String
  }

  class EqualShareAllocation <<ConcreteStrategy>> {
    +allocate(needs: List<Need>, available: int): Map<Need, Integer>
    +name(): String
  }

  enum AllocationMode {
    URGENCY
    FIRST_COME
    EQUAL
    --
    +create(): AllocationStrategy
    +{static} fromString(input: String): AllocationMode
  }
}

package "TEMPLATE METHOD: impact reports" as template #FDF3E7 {
  abstract class ImpactReport <<AbstractClass>> {
    ~{static} ORGANIZATION: String
    #reportDate: LocalDate
    --
    #ImpactReport(reportDate: LocalDate)
    +generate(): String
    .. steps ..
    #{abstract} title(): String
    #{abstract} scope(): String
    #{abstract} collectData(): void
    #{abstract} hasData(): boolean
    #{abstract} computeMetrics(): Map<String, String>
    #{abstract} formatRows(): List<String>
    #{abstract} summary(): String
    .. hook ..
    #footer(): String
  }

  class ProgramImpactReport <<ConcreteClass>> {
    -program: String
    -allDistributions: List<Distribution>
    -distributions: List<Distribution>
    -reached: Set<Beneficiary>
    -needsServed: Set<Need>
    --
    +ProgramImpactReport(program: String, allDistributions: List<Distribution>, reportDate: LocalDate)
    #title(): String
    #scope(): String
    #collectData(): void
    #hasData(): boolean
    #computeMetrics(): Map<String, String>
    #formatRows(): List<String>
    #summary(): String
  }

  class BeneficiaryProgressReport <<ConcreteClass>> {
    -beneficiary: Beneficiary
    -needs: List<Need>
    --
    +BeneficiaryProgressReport(beneficiary: Beneficiary, reportDate: LocalDate)
    #title(): String
    #scope(): String
    #collectData(): void
    #hasData(): boolean
    #computeMetrics(): Map<String, String>
    #formatRows(): List<String>
    #summary(): String
  }
}

