@startuml donation
' Donations module (Student 1): class diagram grouped by design pattern.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60
hide circle
hide empty members
top to bottom direction

package "org.nonprofit.core (shared)" as core #F5F5F5 {
  abstract class Person {
    -id: String
    -name: String
    -email: String
    -phone: String
    -preferredContact: ContactPreference
  }
  class EventBus <<Singleton>> {
    +{static} getInstance(): EventBus
    +subscribe(type: SystemEventType, observer: SystemObserver): void
    +publish(event: SystemEvent): void
  }
  interface SystemObserver <<Observer>> {
    +onEvent(event: SystemEvent): void
  }
}

package "FACTORY METHOD: creating donations" as factory #EAF2FB {
  abstract class DonationCreator <<Creator>> {
    +receive(id: String, donor: Donor, date: LocalDate, form: DonationForm): Donation {final}
    #{abstract} createDonation(id: String, donor: Donor, date: LocalDate, form: DonationForm): Donation
    +{abstract} getType(): DonationType
  }
  class OnlineDonationCreator <<ConcreteCreator>> {
    #createDonation(id, donor, date, form): Donation
    +getType(): DonationType
  }
  class CheckDonationCreator <<ConcreteCreator>> {
    #createDonation(id, donor, date, form): Donation
    +getType(): DonationType
  }
  class InKindDonationCreator <<ConcreteCreator>> {
    #createDonation(id, donor, date, form): Donation
    +getType(): DonationType
  }

  class DonationForm {
    -amount: double
    -reference: String
    -bank: String
    -item: String
    -monthly: boolean
    -campaign: String
  }

  enum DonationType {
    ONLINE
    CHECK
    IN_KIND
    --
    +{static} fromText(text: String): DonationType
  }

  abstract class Donation <<Product>> {
    -id: String
    -donor: Donor
    -amount: double
    -date: LocalDate
    -campaign: Campaign
    --
    +{abstract} getType(): DonationType
    +{abstract} getDetails(): String
    +{static} money(amount: double): String
  }

  class OnlineDonation <<ConcreteProduct>> {
    -paymentReference: String
    -monthly: boolean
    --
    +isMonthly(): boolean
  }

  class CheckDonation <<ConcreteProduct>> {
    -checkNumber: String
    -bankName: String
  }

  class InKindDonation <<ConcreteProduct>> {
    -item: String
  }
}

package "TEMPLATE METHOD: receipts and tax statements" as template #FDF3E7 {
  abstract class DonationDocument <<AbstractClass>> {
    +{static} ORGANIZATION: String
    -issueDate: LocalDate
    --
    +generate(): String {final}
    .. steps ..
    #{abstract} getTitle(): String
    #{abstract} body(): String
    #{abstract} totals(): String
    .. hooks ..
    #canBeIssued(): boolean
    #header(): String
    #footer(): String
  }

  class DonationReceipt {
    -donation: Donation
    --
    #getTitle(): String
    #body(): String
    #totals(): String
    #footer(): String
  }

  class TaxStatement {
    -donor: Donor
    -year: int
    --
    #getTitle(): String
    #body(): String
    #totals(): String
    #canBeIssued(): boolean
  }
}

package "MODEL: service, donors and campaigns" as model #F3EEF8 {
  class DonationService {
    -donors: Map<String, Donor>
    -donations: Map<String, Donation>
    -campaigns: Map<String, Campaign>
    -creators: Map<DonationType, DonationCreator>
    -donorCount: int
    -donationCount: int
    --
    +addCreator(creator: DonationCreator): void
    +getCreator(type: DonationType): DonationCreator
    +addDonor(name, email, phone, contact): Donor
    +removeDonor(donorId: String): void
    +addCampaign(name: String, goal: double): Campaign
    +donate(donorId: String, type: DonationType, date: LocalDate, form: DonationForm): Donation
    +donate(donorId: String, typeText: String, date: LocalDate, form: DonationForm): Donation
    +getTotalRaised(): double
    +getTotalFor(type: DonationType): double
    +getTopDonors(howMany: int): List<Donor>
    +summaryReport(): String
    +makeReceipt(donationId: String, issueDate: LocalDate): String
    +makeTaxStatement(donorId: String, year: int, issueDate: LocalDate): String
  }

  class Donor {
    -donations: List<Donation>
    --
    +getDonations(): List<Donation>
    +getDonationsIn(year: int): List<Donation>
    +getTotalGiven(): double
    +summary(): String
  }

  class Campaign {
    -name: String
    -goal: double
    -raised: double
    --
    +getProgress(): double
    +isGoalReached(): boolean
  }
}

package "MVC: console screen" as mvc #EEF7EE {
  class DonationApp {
    +{static} main(args: String[]): void
  }
  class DonationController <<Controller>> {
    +run(): void
  }
  class DonationView <<View>> {
    +showMenu(): int
    +ask(question: String): String
    +showList(title: String, items: List): void
    +onEvent(event: SystemEvent): void
  }
  class DonationDemo {
    +{static} main(args: String[]): void
  }
}

' ---- Factory Method: two parallel hierarchies ----
OnlineDonationCreator -up-|> DonationCreator
CheckDonationCreator -up-|> DonationCreator
InKindDonationCreator -up-|> DonationCreator
OnlineDonation -up-|> Donation
CheckDonation -up-|> Donation
InKindDonation -up-|> Donation
DonationCreator ..> Donation : <<creates>>
DonationCreator ..> DonationForm : reads
OnlineDonationCreator ..> OnlineDonation : <<creates>>
CheckDonationCreator ..> CheckDonation : <<creates>>
InKindDonationCreator ..> InKindDonation : <<creates>>
note top of DonationCreator
  receive() is final:
  createDonation() (factory method)
  -> add to donor's history
end note

' ---- Template Method ----
DonationReceipt -up-|> DonationDocument
TaxStatement -up-|> DonationDocument
DonationReceipt --> "1" Donation
TaxStatement --> "1" Donor
note bottom of DonationDocument
  generate() is final:
  header -> body -> totals -> footer
end note

' ---- Model ----
Donor -up-|> Person
Donor "1" <--> "*" Donation
Donation "*" --> "0..1" Campaign
DonationService "1" o-- "*" Donor
DonationService "1" o-- "*" Donation
DonationService "1" o-- "*" Campaign
DonationService "1" o-- "3" DonationCreator : creators
DonationService ..> DonationDocument : <<issues>>
DonationService ..> EventBus : publishes DONATION_RECEIVED

' ---- MVC + Observer ----
DonationApp ..> DonationController
DonationController --> DonationService : model
DonationController --> DonationView : view
DonationView ..|> SystemObserver
EventBus o-- "*" SystemObserver : notifies
DonationDemo ..> DonationService
@enduml
