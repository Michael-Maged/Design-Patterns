    +recordPledge(amount: double): void
    +progressPercent(): double
    #details(): String
  }

  class Workshop {
    ~{static} DEFAULT_TICKET_PRICE: double = 25.0
    -topic: String
    -instructor: String
    --
    +getType(): EventType
    +setTopic(topic: String): void
    +setInstructor(instructor: String): void
    #details(): String
  }

  class OutreachProgram {
    ~{static} DEFAULT_TICKET_PRICE: double = 0.0
    -targetCommunity: String
    --
    +getType(): EventType
    +setTargetCommunity(targetCommunity: String): void
    #details(): String
  }
}

package "OBSERVER: notifying about event changes" as observer #EEF7EE {
  abstract class Event <<Subject>> {
    -id: String
    -name: String
    -dateTime: LocalDateTime
    -location: String
    -capacity: int
    -baseTicketPrice: double
    -cancelled: boolean
    -registrations: Map<Attendee, Ticket>
    -waitlist: Deque<WaitlistEntry>
    -checkedIn: Set<Attendee>
    -observers: List<EventObserver>
    --
    +{abstract} getType(): EventType
    #{abstract} details(): String
    .. observer ..
    +attach(observer: EventObserver): void
    +detach(observer: EventObserver): void
    #notifyObservers(change: EventChange, message: String): void
    .. changes that notify ..
    +reschedule(newDateTime: LocalDateTime): void
    +relocate(newLocation: String): void
    +cancel(): void
    +remind(): void
    .. registration (package-private) ..
    ~isFull(): boolean
    ~addRegistration(attendee: Attendee, ticket: Ticket): void
    ~removeRegistration(attendee: Attendee): Ticket
    ~addToWaitlist(entry: WaitlistEntry): int
    ~pollWaitlist(): WaitlistEntry
    ~markCheckedIn(attendee: Attendee): void
    .. queries ..
    +getAttendees(): List<Attendee>
    +getWaitlist(): List<Attendee>
    +getCheckedIn(): Set<Attendee>
    +summary(): String
  }

  interface EventObserver <<Observer>> {
    +update(event: Event, change: EventChange, message: String): void
  }

  enum EventChange {
    RESCHEDULED
    RELOCATED
    CANCELLED
    REMINDER
    WAITLIST_PROMOTED
  }

  class Attendee {
    -{static} NEXT_ID: AtomicInteger
    -inbox: List<String>
    --
    +Attendee(name: String, email: String, phone: String, preferredContact: ContactPreference)
    +update(event: Event, change: EventChange, message: String): void
    +getInbox(): List<String>
  }

  class EventBusNotifier {
    +update(event: Event, change: EventChange, message: String): void
  }
}

package "DECORATOR: ticket add-ons" as decorator #FDF3E7 {
  interface Ticket <<Component>> {
    +price(): double
    +description(): String
    +getEvent(): Event
    +getHolder(): Attendee
