package "FACTORY: creating events" as factory #EAF2FB {
  enum EventType {
    FUNDRAISER
    WORKSHOP
    OUTREACH
    --
    +{static} fromString(input: String): EventType
  }

  class EventFactory <<Factory>> {
    -{static} NEXT_ID: AtomicInteger
    --
    -EventFactory()
    +{static} create(type: EventType, name: String, dateTime: LocalDateTime, location: String, capacity: int): Event
    +{static} create(typeInput: String, name: String, dateTime: LocalDateTime, location: String, capacity: int): Event
  }

  class Fundraiser {
    ~{static} DEFAULT_TICKET_PRICE: double = 100.0
    -fundraisingGoal: double
    -amountRaised: double
    --
    +getType(): EventType
