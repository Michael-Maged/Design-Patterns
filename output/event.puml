  class BasicTicket <<ConcreteComponent>> {
    -event: Event
    -holder: Attendee
    --
    +BasicTicket(event: Event, holder: Attendee)
    +price(): double
    +description(): String
  }

  abstract class TicketDecorator <<Decorator>> {
    #wrapped: Ticket
