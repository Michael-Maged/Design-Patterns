    #TicketDecorator(wrapped: Ticket)
    +price(): double
    +description(): String
    +getEvent(): Event
    +getHolder(): Attendee
  }

  class VipTicket {
    ~{static} SURCHARGE: double = 50.0
    --
    +price(): double
    +description(): String
  }

  class MealTicket {
    ~{static} SURCHARGE: double = 15.0
    --
    +price(): double
    +description(): String
  }

  class ParkingTicket {
    ~{static} SURCHARGE: double = 10.0
    --
    +price(): double
    +description(): String
  }

  enum TicketAddOn {
    VIP
    MEAL
    PARKING
    --
    +applyTo(ticket: Ticket): Ticket
    +{static} fromString(input: String): TicketAddOn
  }
}

