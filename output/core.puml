package "SINGLETON + OBSERVER: system-wide notification hub" as hub #EEF7EE {
  class EventBus <<Singleton>> {
    -{static} instance: EventBus
    -subscribers: Map<SystemEventType, List<SystemObserver>>
    --
    -EventBus()
    +{static} getInstance(): EventBus
    +subscribe(type: SystemEventType, observer: SystemObserver): void
    +unsubscribe(type: SystemEventType, observer: SystemObserver): void
    +publish(event: SystemEvent): void
  }

  interface SystemObserver <<Observer>> {
    +onEvent(event: SystemEvent): void
  }

  class SystemEvent {
    -type: SystemEventType
    -message: String
    -recipient: Person
    -source: Object
    --
    +SystemEvent(type: SystemEventType, message: String, recipient: Person, source: Object)
    +getType(): SystemEventType
    +getMessage(): String
    +getRecipient(): Person
    +getSource(): Object
  }

  enum SystemEventType {
    DONATION_RECEIVED
    VOLUNTEER_ASSIGNED
    RESOURCE_DISTRIBUTED
    URGENT_NEED
    EVENT_REGISTERED
    EVENT_UPDATED
    EVENT_REMINDER
    EVENT_CANCELLED
    WAITLIST_PROMOTED
  }
}

package "Shared people model" as people #F5F5F5 {
  abstract class Person {
    -id: String
    -name: String
    -email: String
    -phone: String
    -preferredContact: ContactPreference
    --
    #Person(id: String, name: String, email: String, phone: String, preferredContact: ContactPreference)
    +getId(): String
    +getName(): String
    +getEmail(): String
    +getPhone(): String
    +getPreferredContact(): ContactPreference
    +updateContact(name: String, email: String, phone: String, preferredContact: ContactPreference): void
    #{static} requireName(name: String): String
  }

  enum ContactPreference {
    EMAIL
    SMS
    SOCIAL_MEDIA
  }
}

interface Audience {
  +getAudience(): List<Person>
}

hub -[hidden]down- people

Audience ..> Person
SystemEvent ..> Audience : source may be one

EventBus --> "1" EventBus : instance
EventBus "1" o-- "*" SystemObserver : subscribers
EventBus ..> SystemEvent : publishes
SystemObserver ..> SystemEvent
SystemEvent --> SystemEventType
SystemEvent --> "0..1" Person : recipient
Person --> ContactPreference

note right of EventBus
  One instance for the whole system
  (lazy, double-checked locking).
  Modules publish; others subscribe.
  Lecture names: subscribe = registerObserver,
  unsubscribe = removeObserver,
  publish = notifyObservers;
  SystemObserver.onEvent = update.
end note

note bottom of Person
  name and contact details can be edited
  (updateContact); the id never changes.
  requireName() is checked before a subclass
  takes the next ID number.
end note
