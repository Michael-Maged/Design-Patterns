@startuml overall
' Whole system (CSE336 non-profit management system): overall class diagram with every design pattern marked.
' Written by hand from the source in SDP/src (all org.nonprofit packages plus App.java); the UML generator was not used.
' Only the important fields and methods are shown. Left out on purpose: demo classes (*Demo, SystemDemo,
' VolunteerApp; SampleData is shown only as App's loader), trivial getters/setters, private helpers, id counters, and minor value types
' (HourEntry, WaitlistEntry, EventChange, RegistrationResult, Campaign, SentMessage, Message, DonationType, Urgency).
' The per-module diagrams (core, donation, volunteer, event, beneficiary, communication .puml) have the full detail.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #B0A060
skinparam linetype ortho
hide circle
hide empty members
left to right direction

' ============================================================ entry point
class App {
  +{static} main(args: String[]): void
}

' ============================================================ app
package "org.nonprofit.app" as app #FFF3E0 {
  class MainMenuController <<Controller>> {
    -facade: NonProfitFacade
    -view: MainMenuView
    -volunteerScreen: VolunteerController
    --
    +run(): void
  }

  class MainMenuView <<View>> {
    +showMainMenu(): int
    +ask(prompt: String): String
    +showList(lines: List<String>, emptyText: String): void
    +showError(message: String): void
  }

  class NonProfitFacade <<Facade>> {
    -store: DataStore
    --
    +registerDonor(name: String, email: String, phone: String, contact: ContactPreference): Donor
    +recordDonation(donorId: String, type: String, date: LocalDate, details: DonationDetails): Donation
    +assignTask(taskId: String): Volunteer
    +createEvent(type: String, name: String, dateTime: LocalDateTime, location: String, capacity: int): Event
    +registerNewAttendee(eventId: String, name: String, email: String, phone: String, contact: ContactPreference, addOns: List<String>): RegistrationResult
    +distribute(program: String, category: String, available: int, date: LocalDate): List<Distribution>
    +broadcast(group: BroadcastGroup, subject: String, text: String, urgent: boolean, forced: ContactPreference): int
  }

  class DataStore <<Singleton>> {
    +{static} ORGANISATION: String
    -{static} instance: DataStore
    -attendees: Map<String, Attendee>
    --
    -DataStore()
    +{static} getInstance(): DataStore
    +getDonationService(): DonationService
    +addAttendee(attendee: Attendee): Attendee
  }

  class SampleData {
    +{static} load(facade: NonProfitFacade): void
  }

  enum BroadcastGroup {
    DONORS
    VOLUNTEERS
    BENEFICIARIES
    ATTENDEES
  }

  note top of DataStore
    <b>SINGLETON</b>: DataStore (lazy, double-checked locking).
    Owns exactly one of each service so every screen
    shares the same data and every EventBus message is sent once.
    Its constructor wires the urgent responders: BeneficiaryService
    gets an Audience of the current volunteers (not the Facade).
  end note

  note right of NonProfitFacade
    <b>FACADE</b>: NonProfitFacade is the one entry point the menus use;
    it hides DataStore and the five module services.
    <b>MVC</b>: MainMenuView (View) / MainMenuController (Controller);
    the services behind the facade are the Model.
  end note
}

' ============================================================ core
package "org.nonprofit.core" as core #F5F5F5 {
  abstract class Person {
    -id: String
    -name: String
    -email: String
    -phone: String
    -preferredContact: ContactPreference
  }

  enum ContactPreference {
    EMAIL
    SMS
    SOCIAL_MEDIA
  }

  interface Audience {
    +getAudience(): List<? extends Person>
  }

  class EventBus <<Singleton>> <<Subject>> {
    -{static} instance: EventBus
    -subscribers: Map<SystemEventType, List<SystemObserver>>
    --
    -EventBus()
    +{static} getInstance(): EventBus
    +subscribe(type: SystemEventType, observer: SystemObserver): void
    +publish(event: SystemEvent): void
  }

  interface SystemObserver <<Observer>> {
    +onEvent(event: SystemEvent): void
  }

  class SystemEvent {
    -type: SystemEventType
    -message: String
    -recipient: Person
    -source: Object
  }

  enum SystemEventType {
    DONATION_RECEIVED
    VOLUNTEER_ASSIGNED
    URGENT_NEED
    EVENT_UPDATED
    ...
  }

  note bottom of EventBus
    <b>SINGLETON + OBSERVER</b>: EventBus (Subject, getInstance()),
    SystemObserver (Observer), SystemEvent (message).
    Services publish; CommunicationService subscribes to every type,
    VolunteerView to VOLUNTEER_ASSIGNED.
  end note
}

' ============================================================ donation
package "org.nonprofit.donation" as donation #E8F5E9 {
  class DonationService {
    -processors: Map<DonationType, DonationProcessor>
    -bus: EventBus
    --
    +registerDonor(donor: Donor): Donor
    +recordDonation(donorId: String, type: DonationType, date: LocalDate, details: DonationDetails): Donation
    +receipt(donationId: String, issueDate: LocalDate): String
    +taxStatement(donorId: String, year: int, issueDate: LocalDate): String
  }

  class Donor {
    -donations: List<Donation>
    --
    +getTotalGiven(): double
  }

  abstract class DonationProcessor <<Creator>> {
    +receive(donor: Donor, date: LocalDate, details: DonationDetails): Donation
    #{abstract} createDonation(id: String, donor: Donor, date: LocalDate, details: DonationDetails): Donation
  }
  class OnlineDonationProcessor <<ConcreteCreator>>
  class CheckDonationProcessor <<ConcreteCreator>>
  class InKindDonationProcessor <<ConcreteCreator>>

  abstract class Donation <<Product>> {
    -donor: Donor
    -value: double
    -date: LocalDate
    --
    +{abstract} getType(): DonationType
    +{abstract} details(): String
  }
  class OnlineDonation <<ConcreteProduct>>
  class CheckDonation <<ConcreteProduct>>
  class InKindDonation <<ConcreteProduct>>

  class DonationDetails {
    +{static} of(amount: double): DonationDetails
    +reference(reference: String): DonationDetails
  }

  abstract class DonationDocument <<AbstractClass>> {
    #issueDate: LocalDate
    --
    +generate(): String
    #{abstract} title(): String
    #{abstract} body(): String
    #{abstract} totals(): String
  }
  class DonationReceipt <<ConcreteClass>>
  class TaxDeductionStatement <<ConcreteClass>>

  note bottom of DonationProcessor
    <b>FACTORY METHOD</b>: DonationProcessor (Creator) with final
    receive() calling createDonation(); Online/Check/InKind
    processors (ConcreteCreator) build the matching Donation (Product).
  end note

  note bottom of DonationDocument
    <b>TEMPLATE METHOD</b>: generate() is final:
    header -> body -> totals -> footer.
    DonationReceipt, TaxDeductionStatement fill the steps.
  end note
}

' ============================================================ volunteer
package "org.nonprofit.volunteer" as volunteer #E3F2FD {
  class VolunteerController <<Controller>> {
    -service: VolunteerService
    -view: VolunteerView
    --
    +run(): void
  }

  class VolunteerView <<View>> {
    +showMenu(currentRule: String): int
    +ask(prompt: String): String
    +onEvent(event: SystemEvent): void
  }

  class VolunteerService <<Model>> <<Context>> {
    -volunteers: Map<String, Volunteer>
    -tasks: Map<String, Task>
    -strategy: AssignmentStrategy
    -bus: EventBus
    --
    +setStrategy(mode: AssignmentMode): void
    +assign(taskId: String): Volunteer
    +logHours(taskId: String, hours: double, date: LocalDate): void
    +issueHoursCertificate(volunteerId: String, date: LocalDate): String
  }

  class Volunteer {
    -skills: Set<String>
    -availability: Set<DayOfWeek>
    -tasks: List<Task>
    --
    +getTotalHours(): double
  }

  class Task {
    -requiredSkill: String
    -day: DayOfWeek
    -assignedVolunteer: Volunteer
  }

  interface AssignmentStrategy <<Strategy>> {
    +pick(task: Task, candidates: List<Volunteer>): Volunteer
    +name(): String
  }
  class SkillBasedAssignment <<ConcreteStrategy>>
  class AvailabilityBasedAssignment <<ConcreteStrategy>>
  class PreferenceBasedAssignment <<ConcreteStrategy>>

  enum AssignmentMode {
    SKILL
    AVAILABILITY
    PREFERENCE
    --
    +create(): AssignmentStrategy
  }

  abstract class Certificate <<AbstractClass>> {
    #volunteer: Volunteer
    --
    +issue(): String
    #{abstract} title(): String
    #{abstract} achievement(): String
    #isEligible(): boolean
  }
  class HoursCertificate <<ConcreteClass>>
  class EventParticipationCertificate <<ConcreteClass>>

  note top of VolunteerController
    <b>MVC</b>: VolunteerView (View, also a SystemObserver),
    VolunteerController (Controller), VolunteerService (Model).
  end note

  note bottom of AssignmentStrategy
    <b>STRATEGY</b>: VolunteerService (Context) -> AssignmentStrategy;
    Skill / Availability / Preference based; AssignmentMode creates them.
  end note

  note bottom of Certificate
    <b>TEMPLATE METHOD</b>: issue() is final;
    HoursCertificate, EventParticipationCertificate.
  end note
}

' ============================================================ event
package "org.nonprofit.event" as event #F3E5F5 {
  class EventService {
    -events: Map<String, Event>
    -busNotifier: EventObserver
    -bus: EventBus
    --
    +createEvent(type: EventType, name: String, dateTime: LocalDateTime, location: String, capacity: int): Event
    +register(eventId: String, attendee: Attendee, addOns: TicketAddOn...): RegistrationResult
    +cancelEvent(eventId: String): void
  }

  class EventFactory <<Factory>> {
    -EventFactory()
    +{static} create(type: EventType, name: String, dateTime: LocalDateTime, location: String, capacity: int): Event
  }

  enum EventType {
    FUNDRAISER
    WORKSHOP
    OUTREACH
  }

  abstract class Event <<Subject>> {
    -capacity: int
    -registrations: Map<Attendee, Ticket>
    -observers: List<EventObserver>
    --
    +attach(observer: EventObserver): void
    #notifyObservers(change: EventChange, message: String): void
    +cancel(): void
    +getAudience(): List<Attendee>
    +{abstract} getType(): EventType
  }
  class Fundraiser
  class Workshop
  class OutreachProgram

  interface EventObserver <<Observer>> {
    +update(event: Event, change: EventChange, message: String): void
  }

  class Attendee <<ConcreteObserver>> {
    -inbox: List<String>
    --
    +update(event: Event, change: EventChange, message: String): void
  }

  class EventBusNotifier <<ConcreteObserver>> {
    +update(event: Event, change: EventChange, message: String): void
  }

  interface Ticket <<Component>> {
    +price(): double
    +description(): String
  }

  class BasicTicket <<ConcreteComponent>> {
    -event: Event
    -holder: Attendee
  }

  abstract class TicketDecorator <<Decorator>> {
    #wrapped: Ticket
    --
    +price(): double
    +description(): String
  }
  class VipTicket <<ConcreteDecorator>>
  class MealTicket <<ConcreteDecorator>>
  class ParkingTicket <<ConcreteDecorator>>

  enum TicketAddOn {
    VIP
    MEAL
    PARKING
    --
    +applyTo(ticket: Ticket): Ticket
  }

  note top of EventFactory
    <b>FACTORY</b>: EventFactory.create(EventType, ...)
    returns Fundraiser / Workshop / OutreachProgram
    (their constructors are package-private).
  end note

  note bottom of EventObserver
    <b>OBSERVER</b> (events): Event (Subject: attach/notifyObservers),
    EventObserver; Attendee and EventBusNotifier (package-private)
    are ConcreteObservers. EventBusNotifier forwards changes to EventBus.
  end note

  note bottom of TicketDecorator
    <b>DECORATOR</b>: Ticket (Component), BasicTicket,
    TicketDecorator wraps a Ticket; Vip / Meal / Parking
    add to price() and description(). TicketAddOn applies them.
  end note
}

' ============================================================ beneficiary
package "org.nonprofit.beneficiary" as beneficiary #E0F2F1 {
  class BeneficiaryService <<Context>> {
    -strategy: AllocationStrategy
    -urgentResponders: Audience
    -bus: EventBus
    --
    +addNeed(beneficiaryId: String, category: String, quantity: int, urgency: Urgency, requestedOn: LocalDate): Need
    +setStrategy(mode: AllocationMode): void
    +distribute(program: String, category: String, available: int, date: LocalDate): List<Distribution>
    +programImpactReport(program: String, date: LocalDate): String
  }

  class Beneficiary {
    -area: String
    -householdSize: int
    -needs: List<Need>
    --
    +openNeeds(): List<Need>
  }

  class Need {
    -category: String
    -quantity: int
    -urgency: Urgency
    -received: int
    --
    +remaining(): int
  }

  class Distribution {
    -need: Need
    -quantity: int
    -program: String
  }

  interface AllocationStrategy <<Strategy>> {
    +allocate(needs: List<Need>, available: int): Map<Need, Integer>
    +name(): String
  }
  class UrgencyFirstAllocation <<ConcreteStrategy>>
  class FirstComeFirstServedAllocation <<ConcreteStrategy>>
  class EqualShareAllocation <<ConcreteStrategy>>

  enum AllocationMode {
    URGENCY
    FIRST_COME
    EQUAL
    --
    +create(): AllocationStrategy
  }

  abstract class ImpactReport <<AbstractClass>> {
    #reportDate: LocalDate
    --
    +generate(): String
    #{abstract} collectData(): void
    #{abstract} computeMetrics(): Map<String, String>
    #{abstract} formatRows(): List<String>
  }
  class ProgramImpactReport <<ConcreteClass>>
  class BeneficiaryProgressReport <<ConcreteClass>>

  note bottom of AllocationStrategy
    <b>STRATEGY</b>: BeneficiaryService (Context) -> AllocationStrategy;
    UrgencyFirst / FirstComeFirstServed / EqualShare; AllocationMode creates them.
  end note

  note bottom of ImpactReport
    <b>TEMPLATE METHOD</b>: generate() is final:
    collectData -> hasData -> computeMetrics -> formatRows -> summary.
    ProgramImpactReport, BeneficiaryProgressReport.
  end note
}

' ============================================================ communication
package "org.nonprofit.communication" as communication #FFFDE7 {
  class CommunicationService <<Observer>> {
    -organisation: String
    -selector: ChannelSelector
    --
    +onEvent(event: SystemEvent): void
    +broadcast(recipients: Collection<? extends Person>, subject: String, text: String, urgent: boolean, forced: ContactPreference): int
    +send(recipient: Person, subject: String, text: String, urgent: boolean, forced: ContactPreference): boolean
    ~compose(text: String, urgent: boolean, channel: CommunicationChannel): String
  }

  class ChannelSelector {
    +channelFor(person: Person): CommunicationChannel
    +channelFor(preference: ContactPreference): CommunicationChannel
  }

  interface CommunicationChannel <<Strategy>> {
    +send(message: Message): void
    +name(): String
  }
  class EmailChannel <<ConcreteStrategy>>
  class SmsChannel <<ConcreteStrategy>>
  class SocialMediaChannel <<ConcreteStrategy>> {
    -platform: String
  }

  interface MessageContent <<Component>> {
    +render(): String
  }
  class PlainContent <<ConcreteComponent>> {
    -text: String
  }
  abstract class ContentDecorator <<Decorator>> {
    #wrapped: MessageContent
    --
    +render(): String
  }
  class UrgentTagDecorator <<ConcreteDecorator>>
  class SignatureDecorator <<ConcreteDecorator>> {
    -organisation: String
  }
  class FooterDecorator <<ConcreteDecorator>>

  note bottom of CommunicationChannel
    <b>STRATEGY</b>: CommunicationChannel; ChannelSelector picks
    Email / Sms / SocialMedia from the person's ContactPreference.
  end note

  note bottom of ContentDecorator
    <b>DECORATOR</b>: MessageContent (Component), PlainContent;
    UrgentTag / Signature / Footer decorators wrap the text in compose().
  end note
}

